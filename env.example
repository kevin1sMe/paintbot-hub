# PaintBot Hub 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# 端口配置
PORT=8080

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE_URL=https://api.openai.com/v1

# 智谱AI API 配置
ZHIPU_API_KEY=your_zhipu_api_key_here

# 百度千帆 API 配置
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# 阿里云通义万相 API 配置
ALIYUN_WANX_KEY=your_aliyun_wanx_key_here
# 可选：新模型或其他地域使用控制台给出的业务空间 API 地址
ALIYUN_WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 火山引擎豆包 API 配置
# Seedream 使用 Ark API Key；旧通用模型使用 VOLCENGINE_KEY=AccessKeyId:SecretAccessKey
ARK_API_KEY=your_ark_api_key_here
VOLCENGINE_KEY=

# Google Gemini API 配置
GEMINI_API_KEY=your_gemini_api_key_here

# MiniMax API 配置（国际站密钥）
MINIMAX_API_KEY=your_minimax_api_key_here

# 代理服务器配置（可选）
PROXY_URL=http://your_proxy_server:port
